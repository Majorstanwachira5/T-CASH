datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  USER
  ADMIN
  AUDITOR
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentPurpose {
  GAME_ENTRY
  WALLET_DEPOSIT
  REPEAT_CREDIT
}

enum EntryStatus {
  PENDING_PAYMENT
  AUTHORIZED
  REVEALED
  SETTLED
  CANCELLED
}

enum PrizeClaimStatus {
  PENDING_REVIEW
  APPROVED
  PAID
  REJECTED
}

enum LedgerTransactionType {
  CREDIT_DEPOSIT
  CREDIT_PRIZE
  DEBIT_ENTRY_FEE
  DEBIT_REPEAT_CREDIT
  DEBIT_WITHDRAWAL
  ADJUSTMENT
}

enum CommentStatus {
  ACTIVE
  HIDDEN
  FLAGGED
}

enum CommentCategory {
  PLAYER_EXPERIENCE
  CONFIRMED_WIN
  LOSS_REPORTED
  SUGGESTION
  QUESTION
}

model User {
  id              String         @id @default(uuid())
  email           String         @unique
  phone           String?        @unique
  fullName        String
  passwordHash    String
  role            UserRole       @default(USER)
  status          AccountStatus  @default(ACTIVE)
  suspensionReason String?
  mfaSecret       String?
  mfaEnabled      Boolean        @default(false)
  deletedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  sessions        Session[]
  entries         GameEntry[]
  payments        PaymentTransaction[]
  wallet          WalletAccount?
  prizeClaims     PrizeClaim[]
  notifications   Notification[]
  auditLogs       AdminAuditLog[]      @relation("AdminAudits")
  comments        Comment[]

  @@index([email])
  @@index([phone])
  @@index([role])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionToken])
  @@index([userId])
}

model WalletAccount {
  id           String              @id @default(uuid())
  userId       String              @unique
  balanceCents BigInt              @default(0) // 100 cents = 1 KES
  currency     String              @default("KES")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  ledgerEntries WalletLedgerEntry[]

  @@index([userId])
}

model WalletLedgerEntry {
  id                 String                @id @default(uuid())
  walletAccountId    String
  transactionType    LedgerTransactionType
  amountCents        BigInt
  balanceBeforeCents BigInt
  balanceAfterCents  BigInt
  reference          String                @unique
  reason             String
  metadata           String?               // JSON string
  createdAt          DateTime              @default(now())

  walletAccount      WalletAccount         @relation(fields: [walletAccountId], references: [id], onDelete: Restrict)

  @@index([walletAccountId])
  @@index([reference])
}

model GameConfig {
  id                String       @id @default(uuid())
  version           Int          @unique @default(1)
  name              String       @default("T CPI Official Draw")
  description       String       @default("10-Box Mystery Number Game")
  entryPriceCents   BigInt       @default(10000)   // KSh 100.00
  repeatCreditCents BigInt       @default(200)     // KSh 2.00
  prizeAmountCents  BigInt       @default(5000000) // KSh 50,000.00
  totalPositions    Int          @default(10)      // Exactly 10 ordered boxes
  numberMin         Int          @default(1)
  numberMax         Int          @default(99)
  isUniqueRequired  Boolean      @default(false)
  targetNumbers     String                         // JSON string array of 10 numbers e.g. "[7, 14, 21, 33, 42, 50, 63, 77, 88, 99]"
  isPublished       Boolean      @default(true)
  isActive          Boolean      @default(true)
  publishedAt       DateTime?
  createdByAdminId  String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  entries           GameEntry[]

  @@index([version])
  @@index([isActive])
}

model GameEntry {
  id                   String              @id @default(uuid())
  entryReference       String              @unique // Unique visible code e.g. "TCPI-ENT-938210"
  userId               String
  gameConfigId         String
  ruleVersion          Int
  generatedNumbers     String              // JSON string array of 10 server-generated numbers
  matchedCount         Int                 @default(0)
  matchedPositions     String              // JSON string array of boolean/indices
  isWinner             Boolean             @default(false)
  prizeAwardedCents    BigInt              @default(0)
  status               EntryStatus         @default(PENDING_PAYMENT)
  paymentTransactionId String?             @unique
  entropySeedHash      String              // Cryptographic audit seed hash
  idempotencyKey       String?             @unique
  isPubliclyShared     Boolean             @default(true) // For activity feed
  ipAddress            String?
  userAgent            String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  user                 User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  gameConfig           GameConfig          @relation(fields: [gameConfigId], references: [id])
  paymentTransaction   PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id])
  result               GameResult?
  prizeClaim           PrizeClaim?
  comments             Comment[]

  @@index([userId])
  @@index([entryReference])
  @@index([status])
  @@index([isWinner])
  @@index([createdAt])
}

model GameResult {
  id                    String    @id @default(uuid())
  entryId               String    @unique
  targetNumbersSnapshot String    // Snapshot of published target at game time
  userNumbersSnapshot   String    // Snapshot of player numbers
  matchedIndices        String    // JSON string array of matched indices
  isAudited             Boolean   @default(false)
  auditNotes            String?
  createdAt             DateTime  @default(now())

  entry                 GameEntry @relation(fields: [entryId], references: [id], onDelete: Restrict)

  @@index([entryId])
}

model PaymentTransaction {
  id                 String         @id @default(uuid())
  reference          String         @unique // TCPI-PAY-XXXXXX
  paystackReference  String?        @unique
  userId             String
  amountCents        BigInt         // Integer minor units e.g. 10000 = KSh 100
  currency           String         @default("KES")
  status             PaymentStatus  @default(PENDING)
  channel            String         @default("paystack")
  purpose            PaymentPurpose @default(GAME_ENTRY)
  idempotencyKey     String?        @unique
  metadata           String?        // JSON string with game details / repeat flags
  rawWebhookResponse String?        // Verification / webhook payload JSON
  verifiedAt         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  user               User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  gameEntry          GameEntry?

  @@index([reference])
  @@index([paystackReference])
  @@index([userId])
  @@index([status])
}

model PaymentWebhookEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique
  eventType   String
  reference   String
  signature   String
  payload     String   // Full JSON payload
  isProcessed Boolean  @default(false)
  error       String?
  createdAt   DateTime @default(now())

  @@index([reference])
  @@index([eventId])
}

model PrizeClaim {
  id              String           @id @default(uuid())
  claimReference  String           @unique // TCPI-CLM-XXXXXX
  entryId         String           @unique
  userId          String
  amountCents     BigInt
  status          PrizeClaimStatus @default(PENDING_REVIEW)
  payoutMethod    String?          // e.g. "MPESA", "BANK"
  payoutReference String?
  approvedByAdminId String?
  approvedAt      DateTime?
  paidAt          DateTime?
  rejectionReason String?
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  entry           GameEntry        @relation(fields: [entryId], references: [id])
  user            User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([claimReference])
  @@index([status])
  @@index([userId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model AdminAuditLog {
  id         String   @id @default(uuid())
  adminId    String
  action     String   // e.g. "UPDATE_TARGET_NUMBERS", "SUSPEND_USER", "APPROVE_PRIZE", "MODERATE_COMMENT"
  targetType String   // e.g. "GameConfig", "User", "PrizeClaim", "PaymentTransaction", "Comment"
  targetId   String?
  ipAddress  String?
  userAgent  String?
  details    String?  // JSON string
  createdAt  DateTime @default(now())

  admin      User     @relation("AdminAudits", fields: [adminId], references: [id])

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}

model Comment {
  id                 String          @id @default(uuid())
  userId             String
  authorAlias        String          // e.g. "Wanjiku K." or custom alias
  content            String          // Text content
  category           CommentCategory @default(PLAYER_EXPERIENCE)
  region             String?         // Optional broad region: Nairobi, Coast, Central, etc.
  status             CommentStatus   @default(ACTIVE)
  isVerifiedWin      Boolean         @default(false)
  associatedEntryId  String?
  reportedCount      Int             @default(0)
  moderatedByAdminId String?
  moderationNotes    String?
  moderatedAt        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  associatedEntry    GameEntry?      @relation(fields: [associatedEntryId], references: [id], onDelete: SetNull)
  reports            CommentReport[]

  @@index([status, createdAt])
  @@index([category])
  @@index([region])
  @@index([userId])
  @@index([associatedEntryId])
}

model CommentReport {
  id             String   @id @default(uuid())
  commentId      String
  reporterUserId String?
  reason         String
  ipAddress      String?
  createdAt      DateTime @default(now())

  comment        Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([commentId])
}
